{
  "name": "alambic",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "app": "electron .",
    "test": "node --test test/*.test.mjs",
    "dist": "vite build && electron-builder --win nsis",
    "vendor": "node scripts/fetch-binaries.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/recursive": "5.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.64.0",
    "vite": "8.3.4"
  },
  "main": "electron/main.js",
  "description": "Convertisseur et éditeur de médias : vidéo, audio, images, PDF et documents Word.",
  "author": "Léïa Percherancier",
  "build": {
    "appId": "fr.altaxia.alambic",
    "productName": "Alambic",
    "copyright": "Léïa Percherancier",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Alambic",
      "license": "LICENSE",
      "include": "build/installer.nsh",
      "artifactName": "Alambic-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "electron/separation-worker.js",
      "electron/separation.js",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**"
    ],
    "extraResources": [
      {
        "from": "vendor/bin",
        "to": "bin"
      },
      {
        "from": "vendor/licenses",
        "to": "licenses"
      },
      {
        "from": "LICENSE",
        "to": "licenses/alambic-LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "leiaperch",
        "repo": "alambic"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "onnxruntime-node": "1.30.0"
  },
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/leiaperch/alambic",
  "repository": {
    "type": "git",
    "url": "https://github.com/leiaperch/alambic.git"
  }
}
